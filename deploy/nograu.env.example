# Copie para /etc/nograu/nograu.env e preencha os valores do servidor.
HTTP_ADDR=:8080
TZ=America/Sao_Paulo
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/db_nograu
SPRING_DATASOURCE_USERNAME=nograu
SPRING_DATASOURCE_PASSWORD=preencha-a-senha
NOGRAU_BASE_URL=https://nograu.com.br
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=preencha-o-email
SPRING_MAIL_PASSWORD=preencha-a-senha-de-aplicativo
NOGRAU_MAIL_FROM=preencha-o-email
# Alternativa: NOGRAU_CONFIG=/caminho/application.properties
# Alternativa de conexão: MYSQL_DSN=usuario:senha@tcp(127.0.0.1:3306)/db_nograu?charset=utf8mb4
